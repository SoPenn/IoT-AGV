// --- กำหนดพินเซนเซอร์สี (I2C) ---
const int SDA_PIN = 21;
const int SCL_PIN = 22;

// --- กำหนดพินมอเตอร์ซ้าย ---
const int IN1 = 19;
const int IN2 = 4;
const int ENA = 18;

// --- กำหนดพินมอเตอร์ขวา ---
const int IN3 = 16;
const int IN4 = 17;
const int ENB = 27;

// --- กำหนดพินเซนเซอร์เดินตามเส้น ---
const int sensorLeft = 14;
const int sensorRight = 13;

// --- ตั้งค่าระบบขับเคลื่อนและการกระชาก (Kick-Start) ---
int motorSpeed = 65;        // ความเร็ววิ่งปกติ
int kickSpeed = 90;         // ความเร็วตอนกระชากออกตัว
int kickDuration_ms = 200;  // ระยะเวลาที่กระชาก (มิลลิวินาที) 200นี่คือต่ำสุดแล้ว
bool isStopped = true;      // ตัวแปรเช็กว่ารถกำลังหยุดนิ่งหรือไม่

// --- ระบบเซนเซอร์สีและการจำสถานะ ---
Adafruit_TCS34725 tcs = Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_50MS, TCS34725_GAIN_4X);

// 🌟 ตัวแปรจดจำว่าหุ่นยนต์เพิ่งออกมาจากสถานีไหน (เริ่มต้นที่ P2 ฝั่งขวา)
String currentStation = "START";

// ตัวแปรสำหรับ Blynk และการแยก Core (FreeRTOS)
String targetStation = "NONE";
bool isWaitingForCommand = true;
String globalDetectedColor = "START_OR_PATH";

TaskHandle_t RobotTask;
TaskHandle_t ColorTask;

// ประกาศฟังก์ชันล่วงหน้า
bool checkArrivalByColor();
bool lineTracking();
void handleIntersection();
void skipIntersection();
void turnRight90();
void turn2Right90();

void setup() {
  Serial.begin(115200);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(sensorLeft, INPUT);
  pinMode(sensorRight, INPUT);

  Serial.println("Connecting to Blynk...");
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, pass);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n=================================");
    Serial.println("✅ WiFi Connected!");
    Serial.print("📡 IP Address: ");
    Serial.println(WiFi.localIP());
    Serial.println("=================================");

    Serial.println("Connecting to Blynk Server...");
    Blynk.config(BLYNK_AUTH_TOKEN);
    if (Blynk.connect()) {
      Serial.println("✅ Blynk Connected!");
    } else {
      Serial.println("❌ Blynk Connection Failed! (Hotspot บล็อกพอร์ต)");
    }
  } else {
    Serial.println("\n❌ WiFi Failed! (รหัสผิด หรือมือถือไม่ได้ปล่อย 2.4GHz หรือลองรีโทรศัพท์)");
  }

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setTimeOut(100);

  if (tcs.begin()) {
    Serial.println("Found Color Sensor!");
    tcs.setInterrupt(false);
  } else {
    Serial.println("No Color Sensor found ... check wiring.");
  }

  stopMotor();
  Blynk.virtualWrite(V0, "Standby. Waiting for command.");
  Blynk.virtualWrite(V4, "IS NOT A STATION");

  // Core 0: สำหรับคุมล้อและอินฟราเรด
  xTaskCreatePinnedToCore(robotControlTask, "RobotTask", 10000, NULL, 1, &RobotTask, 0);

  // Core 1: สำหรับเซนเซอร์สีและแอป Blynk
  xTaskCreatePinnedToCore(colorSensorTask, "ColorTask", 10000, NULL, 1, &ColorTask, 1);

  delay(1000);
}

void loop() {
  Blynk.run();
}

void robotControlTask(void* pvParameters) {
  for (;;) {
    if (!isWaitingForCommand) {
      if (lineTracking()) {
        if (!isWaitingForCommand) {
          handleIntersection();
        }
      }
    } else {
      stopMotor();
    }
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
}

void colorSensorTask(void* pvParameters) {
  String lastColorText = "";
  for (;;) {
    uint16_t r = 0, g = 0, b = 0, c = 0;
    tcs.getRawData(&r, &g, &b, &c);

    // 🌟 DEBUG: แสดงค่าเซนเซอร์สีดิบทาง Serial Monitor
    Serial.print("[COLOR DEBUG] R: ");
    Serial.print(r);
    Serial.print(" | G: ");
    Serial.print(g);
    Serial.print(" | B: ");
    Serial.print(b);
    Serial.print(" | C: ");
    Serial.println(c);

    if (r == 0 && g == 0 && b == 0) {
      Wire.begin(SDA_PIN, SCL_PIN);
      tcs.begin();
    }

    String detectedColor = "START_OR_PATH";
    String colorTextForBlynk = "IS NOT A STATION";

    if (r > 90 && g > 140 && g < 230 && b > 130) {
      detectedColor = "START_OR_PATH";
      colorTextForBlynk = "IS NOT A STATION";
    } else if (r > g && r > b && r > 60) {
      detectedColor = "RED_S2";
      colorTextForBlynk = "RED_S2";
    } else if (r > 90 && r < 150 && g > 240 && g < 360 && b > 90 && b < 200) {
      detectedColor = "GREEN_S3";
      colorTextForBlynk = "GREEN_S3";
    } else if (b > r && b > g && b > 100) {
      detectedColor = "BLUE_S1";
      colorTextForBlynk = "BLUE_S1";
    } else {
      detectedColor = "START_OR_PATH";
      colorTextForBlynk = "IS NOT A STATION";
    }

    globalDetectedColor = detectedColor;

    if (colorTextForBlynk != lastColorText) {
      Blynk.virtualWrite(V4, colorTextForBlynk);
      lastColorText = colorTextForBlynk;
    }
    vTaskDelay(150 / portTICK_PERIOD_MS);
  }
}

// รับคำสั่งจากปุ่มในแอป Blynk
BLYNK_WRITE(V1) {
  if (param.asInt() == 1) {
    targetStation = "BLUE_S1";
    isWaitingForCommand = false;
    Blynk.virtualWrite(V0, "Moving to BLUE S1");
