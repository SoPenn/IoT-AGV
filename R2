// ฟังก์ชันควบคุมมอเตอร์พื้นฐาน
void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void stopMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
  isStopped = true;
}

// 🌟 ฟังก์ชันเช็กเป้าหมาย: หยุดสนิทและเซ็ต isStopped เป็น true
bool checkArrivalByColor() {
  if (!isWaitingForCommand && targetStation != "NONE" && targetStation != "START" && globalDetectedColor == targetStation) {
    stopMotor();
    Serial.println("Arrived at Target Station! Stopping completely.");
    Blynk.virtualWrite(V0, "Arrived at " + targetStation);
    currentStation = targetStation;
    isWaitingForCommand = true;
    targetStation = "NONE";
    isStopped = true;
    return true;
  }
  return false;
}

// --- ตัวแปรเก็บเวลาสำหรับเช็กทางตรงยาว ---
unsigned long whiteTimeStart = 0;
bool isSlowedDown = false;

bool lineTracking() {
  if (checkArrivalByColor()) return true;

  int valLeft = digitalRead(sensorLeft);
  int valRight = digitalRead(sensorRight);

  if (valLeft == 1 && valRight == 1) {  // ดำทั้งคู่(1,1) -> เจอทางแยก
    stopMotor();
    delay(400);
    return true;
  }

  // 🌟 ดักเช็กจังหวะเริ่มออกตัวจากที่จอดนิ่ง (กระชาก)
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }

  // ลอจิกเดินตามเส้นปกติ (เมื่อรถวิ่งอยู่แล้ว)
  if (valLeft == 0 && valRight == 0) {  // ขาวทั้งคู่(0,0) -> ตรง
    analogWrite(ENA, motorSpeed);
    analogWrite(ENB, motorSpeed);
    moveForward();
  } else if (valLeft == 0 && valRight == 1) {  // ซ้ายขาว(0) ขวาดำ(1) -> เลี้ยวขวา
    analogWrite(ENA, 0);
    analogWrite(ENB, 60);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  } else if (valLeft == 1 && valRight == 0) {  // ซ้ายดำ(1) ขวาขาว(0) -> เลี้ยวซ้าย
    analogWrite(ENA, 60);
    analogWrite(ENB, 0);
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
  }
  return false;
}

// 📍 ชุดคำสั่งเสริมเพื่อย่อลอจิกการนำทาง
void arrivedAtStart() {
  if (isWaitingForCommand) return;
  stopMotor();
  Serial.println("Arrived at START (P1)!");
  Blynk.virtualWrite(V0, "Arrived at START");
  currentStation = "START";
  isWaitingForCommand = true;
  targetStation = "NONE";
  isStopped = true;
}

void runRoute(const char* route) {
  for (int i = 0; route[i] != '\0'; i++) {
    if (isWaitingForCommand) return;
    if (route[i] == 'S') skipIntersection();
    else if (route[i] == 'T') turnRight90();
    else if (route[i] == '2') turn2Right90();
  }
}

// 📍 ฟังก์ชันจัดการทางแยกและระบบนำทาง (Routing)
void handleIntersection() {
  if (isWaitingForCommand) return;

  Serial.print("[Routing] Current Station: ");
  Serial.println(currentStation);
  Serial.print("[Routing] Target Station: ");
  Serial.println(targetStation);

  if (globalDetectedColor != "START_OR_PATH" && globalDetectedColor == targetStation) {
    stopMotor();
    Blynk.virtualWrite(V0, "Arrived at " + targetStation);
    currentStation = targetStation;
    isWaitingForCommand = true;
    targetStation = "NONE";
    isStopped = true;
    return;
  }

  if (currentStation == "START") {
    if (targetStation == "BLUE_S1") runRoute("SST");
    else if (targetStation == "RED_S2") runRoute("ST");
    else if (targetStation == "GREEN_S3") runRoute("SSTSTSST");
  } else if (currentStation == "BLUE_S1") {
    if (targetStation == "RED_S2") runRoute("TSSTSTST");
    else if (targetStation == "GREEN_S3") runRoute("TSST");
    else if (targetStation == "START") {
      runRoute("S2SS2S2");
      arrivedAtStart();
    }
  } else if (currentStation == "RED_S2") {
    if (targetStation == "BLUE_S1") runRoute("TSTS2SST");
    else if (targetStation == "GREEN_S3") runRoute("TST");
    else if (targetStation == "START") {
      runRoute("S2S2S2");
      arrivedAtStart();
    }
  } else if (currentStation == "GREEN_S3") {
    if (targetStation == "BLUE_S1") runRoute("TSST");
    else if (targetStation == "RED_S2") runRoute("TST");
    else if (targetStation == "START") {
      runRoute("S2");
      arrivedAtStart();
    }
  }
}

void turnLeft90() {
  if (isWaitingForCommand) return;
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);
  moveForward();
  delay(300);

  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  delay(300);

  while (digitalRead(sensorLeft) == 0) {
    if (isWaitingForCommand) return;
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
  if (isWaitingForCommand) return;
  stopMotor();
  Blynk.virtualWrite(V4, "IS NOT A STATION");
}

void turn2Right90() {
  if (isWaitingForCommand) return;
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }
  unsigned long startTime = millis();

  while (millis() - startTime < 250) {
    if (isWaitingForCommand) return;
    lineTracking();
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }

  if (isWaitingForCommand) return;
  stopMotor();
  delay(250);

  if (isWaitingForCommand) return;
  analogWrite(ENA, 72);
  analogWrite(ENB, 72);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  int blackCount = 0;
  int lastState = digitalRead(sensorRight);

  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorRight);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }

  if (isWaitingForCommand) return;
  stopMotor();
  Blynk.virtualWrite(V4, "IS NOT A STATION");
}

void turnRight90() {
  if (isWaitingForCommand) return;
  stopMotor();
  delay(250);

  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(200);
    isStopped = false;
  }

  if (isWaitingForCommand) return;
  analogWrite(ENA, 72);
  analogWrite(ENB, 72);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  int blackCount = 0;
  int lastState = digitalRead(sensorRight);

  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorRight);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }

  if (isWaitingForCommand) return;
  stopMotor();
  Blynk.virtualWrite(V4, "IS NOT A STATION");
}

void skipIntersection() {
  if (isWaitingForCommand) return;
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }

  while (true) {
    if (isWaitingForCommand) return;
    if (lineTracking()) break;
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}
