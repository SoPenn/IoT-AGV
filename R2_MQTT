#include <WiFi.h>
#include <PicoMQTT.h>
#include <Wire.h>
#include "Adafruit_TCS34725.h"

// --- ข้อมูลเครือข่ายวงแลน (วิ่งไปเกาะ r1) ---
const char* ssid = "AGV_NETWORK";
const char* pass = "12345678";

// --- สร้าง Client ไปเกาะ IP ของ r1 ---
PicoMQTT::Client mqttClient("192.168.4.1", 1883);

// 🌟 โครงสร้างสำหรับ "คิวส่งข้อความข้าม Core" (FreeRTOS Queue)
struct MqttMsg {
  char topic[40];
  char payload[60];
};
QueueHandle_t mqttQueue;

// --- พินมอเตอร์และเซนเซอร์ ---
const int SDA_PIN = 21;
const int SCL_PIN = 22;
const int IN1 = 19;
const int IN2 = 4;
const int ENA = 18;
const int IN3 = 16;
const int IN4 = 17;
const int ENB = 27;
const int sensorLeft = 14;
const int sensorRight = 13;

int motorSpeed = 63;
int turnSpeed = 65;
int kickSpeed = 90;
int kickDuration_ms = 300;
bool isStopped = true;

Adafruit_TCS34725 tcs = Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_50MS, TCS34725_GAIN_4X);

String currentStation = "START";
String friendStation = "NONE";  // 🌟 เก็บตำแหน่งปัจจุบันของ r1
String friendTarget = "NONE";   // 🌟 เก็บเป้าหมายที่ r1 กำลังจะไป
String targetStation = "NONE";
bool isWaitingForCommand = true;
String globalDetectedColor = "START_OR_PATH";

TaskHandle_t RobotTask;
TaskHandle_t ColorTask;

bool checkArrivalByColor();
bool lineTracking();
void handleIntersection();
void skipIntersection();
void turnRight();
void turnLeft();
void moveForward();
void stopMotor();
void arrivedAtStart();
void runRoute(const char* route);
void runDetourRoute(const char* route);  // 🌟 ฟังก์ชันเบี่ยงเส้นทาง
void sendMqttSafe(const char* topic, const char* payload);
void robotControlTask(void* pvParameters);
void colorSensorTask(void* pvParameters);

void setup() {
  Serial.begin(115200);

  // 🌟 สร้างพื้นที่คิว
  mqttQueue = xQueueCreate(20, sizeof(MqttMsg));

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(sensorLeft, INPUT);
  pinMode(sensorRight, INPUT);

  Serial.println("\n--- Starting Client Node (r2) ---");
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, pass);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n✅ WiFi Connected! IP: " + WiFi.localIP().toString());

  // 🌟 ดักฟังคำสั่งจากแอปมือถือ
  mqttClient.subscribe("agv/r2/command", [](const char* topic, const char* payload) {
    String cmd = String(payload);
    cmd.trim();
    Serial.println("[MQTT RECV] Topic: " + String(topic) + " | Payload: " + cmd);

    // 🛑 เพิ่มคำสั่ง STOP
    if (cmd == "STOP") {
      isWaitingForCommand = true;
      targetStation = "NONE";
      stopMotor();
      sendMqttSafe("agv/r2/status", ("Standby (At " + currentStation + ")").c_str());
      sendMqttSafe("agv/r2/station", currentStation.c_str());
      Serial.println("🛑 [ACTION] STOP Command Received! Motor stopped.");
      return;
    }

    String target = "";
    if (cmd == "GO_BLUE") target = "BLUE_S1";
    else if (cmd == "GO_RED") target = "RED_S2";
    else if (cmd == "GO_GREEN") target = "GREEN_S3";
    else if (cmd == "GO_START") target = "START";

    if (target != "") {
      // 🚨 ระบบกันชนอัจฉริยะ: เช็กทั้งตำแหน่งและเป้าหมายล่วงหน้าของ r1
      bool isR1AtTarget = (friendStation == target);
      bool isR1TargetingIt = (friendTarget == target);

      if ((isR1AtTarget || isR1TargetingIt) && target != "START") {
        Serial.println("❌ ไปไม่ได้! r1 จอดขวางหรือกำลังมุ่งหน้าไปที่ " + target);
        sendMqttSafe("agv/r2/status", "Standby (Blocked)");
      } else {
        targetStation = target;
        isWaitingForCommand = false;
        sendMqttSafe("agv/r2/status", ("Moving to " + target).c_str());
        sendMqttSafe("agv/r2/station", "MOVING");  // เคลียร์สถานะตัวเอง
      }
    }
  });

  // 🌟 ดักฟังตำแหน่งปัจจุบันของ r1
  mqttClient.subscribe("agv/r1/station", [](const char* topic, const char* payload) {
    friendStation = String(payload);
    Serial.println("[MQTT RECV] r1 station: " + friendStation);
  });

  // 🌟 ดักฟังเป้าหมายที่ r1 กำลังจะไป (ผ่านทางสถานะ Moving to ...)
  mqttClient.subscribe("agv/r1/status", [](const char* topic, const char* payload) {
    String statusStr = String(payload);
    if (statusStr.startsWith("Moving to ")) {
      friendTarget = statusStr.substring(10);  // เอาเฉพาะชื่อสถานีเป้าหมาย
      Serial.println("[MQTT RECV] r1 target destination: " + friendTarget);
    } else if (statusStr.startsWith("Standby") || statusStr.startsWith("Stopped")) {
      friendTarget = "NONE";  // เคลียร์เป้าหมายถ้า r1 จอดแล้ว
    }
  });

  mqttClient.begin();

  Wire.begin(SDA_PIN, SCL_PIN);
  if (tcs.begin()) tcs.setInterrupt(false);

  stopMotor();
  sendMqttSafe("agv/r2/status", "Standby (Ready)");

  xTaskCreatePinnedToCore(robotControlTask, "RobotTask", 10000, NULL, 1, &RobotTask, 0);
  xTaskCreatePinnedToCore(colorSensorTask, "ColorTask", 10000, NULL, 1, &ColorTask, 1);
}

void sendMqttSafe(const char* topic, const char* payload) {
  MqttMsg msg;
  strlcpy(msg.topic, topic, sizeof(msg.topic));
  strlcpy(msg.payload, payload, sizeof(msg.payload));
  xQueueSend(mqttQueue, &msg, 0);
}

void loop() {
  MqttMsg msg;
  while (xQueueReceive(mqttQueue, &msg, 0) == pdTRUE) {
    mqttClient.publish(msg.topic, msg.payload);
  }
  mqttClient.loop();
  delay(1);
}

void robotControlTask(void* pvParameters) {
  static unsigned long lastIRDebug = 0;
  static unsigned long lastStateDebug = 0;
  static unsigned long lastAppUpdate = 0;

  for (;;) {
    if (millis() - lastIRDebug > 200) {
      int valLeft = digitalRead(sensorLeft);
      int valRight = digitalRead(sensorRight);
      Serial.println("[IR DEBUG] L:" + String(valLeft) + " | R:" + String(valRight));
      lastIRDebug = millis();
    }

    if (millis() - lastStateDebug > 1000) {
      Serial.println("[SYS DEBUG] Curr:" + currentStation + " | Target:" + targetStation + " | r1_at:" + friendStation + " | r1_target:" + friendTarget);
      lastStateDebug = millis();
    }

    if (millis() - lastAppUpdate > 2000) {
      if (isWaitingForCommand) {
        sendMqttSafe("agv/r2/status", ("Standby (At " + currentStation + ")").c_str());
        sendMqttSafe("agv/r2/station", currentStation.c_str());
      }
      lastAppUpdate = millis();
    }

    if (!isWaitingForCommand) {
      if (lineTracking()) {
        if (!isWaitingForCommand) handleIntersection();
      }
    } else {
      stopMotor();
    }
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
}

void colorSensorTask(void* pvParameters) {
  static unsigned long lastColorDebug = 0;

  for (;;) {
    uint16_t r = 0, g = 0, b = 0, c = 0;
    tcs.getRawData(&r, &g, &b, &c);

    if (r == 0 && g == 0 && b == 0) {
      Wire.begin(SDA_PIN, SCL_PIN);
      tcs.begin();
    }

    String detectedColor = "START_OR_PATH";

    if (r > 90 && g > 140 && g < 240 && b > 150) {
      detectedColor = "START_OR_PATH";
    } else if (r > g && r > b && r > 60) {
      detectedColor = "RED_S2";
    } else if (r > 80 && r < 165 && g > 160 && g < 360 && b > 90 && b < 230) {
      detectedColor = "GREEN_S3";
    } else if (r > 49 && r < 90 && g > 130 && g < 240 && b > 180 && b < 365) {
      detectedColor = "BLUE_S1";
    }

    globalDetectedColor = detectedColor;

    if (millis() - lastColorDebug > 500) {
      Serial.println("[COLOR RAW] R:" + String(r) + " G:" + String(g) + " B:" + String(b) + " => " + detectedColor);
      lastColorDebug = millis();
    }

    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}

void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void stopMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
  isStopped = true;
}

bool checkArrivalByColor() {
  if (!isWaitingForCommand && targetStation != "NONE" && targetStation != "START" && globalDetectedColor == targetStation) {
    stopMotor();
    currentStation = targetStation;
    sendMqttSafe("agv/r2/status", ("Standby (At " + targetStation + ")").c_str());
    sendMqttSafe("agv/r2/station", currentStation.c_str());
    isWaitingForCommand = true;
    targetStation = "NONE";
    isStopped = true;
    return true;
  }
  return false;
}

bool lineTracking() {
  if (checkArrivalByColor()) return true;
  int valLeft = digitalRead(sensorLeft);
  int valRight = digitalRead(sensorRight);

  if (valLeft == 1 && valRight == 1) {
    stopMotor();
    delay(400);
    return true;
  }
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }

  if (valLeft == 0 && valRight == 0) {
    analogWrite(ENA, motorSpeed);
    analogWrite(ENB, motorSpeed);
    moveForward();
  } else if (valLeft == 0 && valRight == 1) {
    analogWrite(ENA, 90);
    analogWrite(ENB, 60);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  } else if (valLeft == 1 && valRight == 0) {
    analogWrite(ENA, 90);
    analogWrite(ENB, 60);
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
  }
  return false;
}

void arrivedAtStart() {
  if (isWaitingForCommand) return;
  stopMotor();
  currentStation = "START";
  sendMqttSafe("agv/r2/status", "Standby (At START)");
  sendMqttSafe("agv/r2/station", currentStation.c_str());
  isWaitingForCommand = true;
  targetStation = "NONE";
  isStopped = true;
}

void runRoute(const char* route) {
  Serial.println("[ROUTING] Route: " + String(route));
  for (int i = 0; route[i] != '\0'; i++) {
    if (isWaitingForCommand) return;
    if (route[i] == 'S') skipIntersection();
    else if (route[i] == 'R') turnRight();
    else if (route[i] == 'L') turnLeft();
  }
}

void runDetourRoute(const char* route) {
  Serial.println("[DETOUR ROUTING] Executing Detour Bypass: " + String(route));
  for (int i = 0; route[i] != '\0'; i++) {
    if (isWaitingForCommand) return;
    if (route[i] == 'S') skipIntersection();
    else if (route[i] == 'R') turnRight();
    else if (route[i] == 'L') turnLeft();
  }
}

void handleIntersection() {
  if (isWaitingForCommand) return;

  if (globalDetectedColor != "START_OR_PATH" && globalDetectedColor == targetStation) {
    stopMotor();
    currentStation = targetStation;
    sendMqttSafe("agv/r2/status", ("Standby (At " + targetStation + ")").c_str());
    sendMqttSafe("agv/r2/station", currentStation.c_str());
    isWaitingForCommand = true;
    targetStation = "NONE";
    isStopped = true;
    return;
  }

  // 🌟 เงื่อนไขเบี่ยงเส้นทาง: ครอบคลุมทั้ง r1 จอดอยู่ หรือ r1 กำลังมุ่งหน้าไป
  bool isR1BlockingGreen = (friendStation == "GREEN_S3" || friendTarget == "GREEN_S3");
  bool isR1BlockingRed = (friendStation == "RED_S2" || friendTarget == "RED_S2");

  if (currentStation == "START") {
    if (targetStation == "BLUE_S1") runRoute("LSRSSR");
    else if (targetStation == "RED_S2") runRoute("LSRSR");
    else if (targetStation == "GREEN_S3") runRoute("L");
  } else if (currentStation == "BLUE_S1") {
    if (targetStation == "RED_S2") {
      if (isR1BlockingGreen) {
        Serial.println("🔄 r2 อยู่สีน้ำเงิน แต่ r1 ขวางสีเขียว -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSSRSRSSR");
      } else {
        runRoute("RSSRSRSR");
      }
    } else if (targetStation == "GREEN_S3") {
      runRoute("RSSR");
    } else if (targetStation == "START") {
      runRoute("RSSSL");
      arrivedAtStart();
    }
  } else if (currentStation == "RED_S2") {
    if (targetStation == "BLUE_S1") {
      if (isR1BlockingGreen) {
        Serial.println("🔄 r2 อยู่สีแดง แต่ r1 ขวางสีเขียว -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSRSRSSSR");
      } else {
        runRoute("RSRSRSSR");
      }
    } else if (targetStation == "GREEN_S3") {
      runRoute("RSR");
    } else if (targetStation == "START") {
      runRoute("RSSL");
      arrivedAtStart();
    }
  } else if (currentStation == "GREEN_S3") {
    if (targetStation == "BLUE_S1") runRoute("RSSR");
    else if (targetStation == "RED_S2") runRoute("RSR");
    else if (targetStation == "START") {
      if (isR1BlockingRed) {
        Serial.println("🔄 r2 อยู่สีเขียว แต่ r1 ขวางสีแดง -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSRSRSSSL");
        arrivedAtStart();
      } else {
        runRoute("RSRSRSSL");
        arrivedAtStart();
      }
    }
  }
}

void turnLeft() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Turn Left");
  stopMotor();
  delay(250);
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(300);
    isStopped = false;
  }
  if (isWaitingForCommand) return;
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  int blackCount = 0;
  int lastState = digitalRead(sensorLeft);
  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorLeft);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
  if (isWaitingForCommand) return;
  stopMotor();
  isStopped = false;
}

void turnRight() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Turn Right");
  stopMotor();
  delay(250);
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(250);
    isStopped = false;
  }
  if (isWaitingForCommand) return;
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  int blackCount = 0;
  int lastState = digitalRead(sensorRight);
  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorRight);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
  if (isWaitingForCommand) return;
  stopMotor();
  isStopped = false;
}

void skipIntersection() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Skip Intersection");
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(250);
    isStopped = false;
  }
  while (true) {
    if (isWaitingForCommand) return;
    if (lineTracking()) break;
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}
