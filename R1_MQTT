void robotControlTask(void* pvParameters);
void colorSensorTask(void* pvParameters);

String phoneMac = "CA:14:95:CE:81:B0";
String r2Mac = "FC:E8:C0:74:89:EC";

void wifiEvent(WiFiEvent_t event, WiFiEventInfo_t info) {
  if (event == ARDUINO_EVENT_WIFI_AP_STACONNECTED) {
    char macStr[18];
    snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
             info.wifi_ap_staconnected.mac[0], info.wifi_ap_staconnected.mac[1],
             info.wifi_ap_staconnected.mac[2], info.wifi_ap_staconnected.mac[3],
             info.wifi_ap_staconnected.mac[4], info.wifi_ap_staconnected.mac[5]);
    String connectedMac = String(macStr);
    if (connectedMac == phoneMac) Serial.println("\n[📶 NETWORK] โทรศัพท์เชื่อมต่อแล้ว");
    else if (connectedMac == r2Mac) Serial.println("\n[📶 NETWORK] หุ่นยนต์ r2 เชื่อมต่อแล้ว");
  } else if (event == ARDUINO_EVENT_WIFI_AP_STAIPASSIGNED) {
    Serial.print("[📶 NETWORK] แจก IP สำเร็จ: ");
    Serial.println(IPAddress(info.wifi_ap_staipassigned.ip.addr));
  }
}

void setup() {
  Serial.begin(115200);
  mqttQueue = xQueueCreate(20, sizeof(MqttMsg));

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(sensorLeft, INPUT);
  pinMode(sensorRight, INPUT);

  Serial.println("\n--- Starting Master Node (r1) ---");
  WiFi.onEvent(wifiEvent);
  WiFi.softAP(ap_ssid, ap_pass);
  delay(2000);

  mqttBroker.begin();

  mqttBroker.subscribe("agv/r1/command", [](const char* topic, const char* payload) {
    String cmd = String(payload);
    cmd.trim();
    Serial.println("[MQTT RECV] Topic: " + String(topic) + " | Payload: " + cmd);

    if (cmd == "STOP") {
      isWaitingForCommand = true;
      targetStationID = 0;
      stopMotor();
      sendMqttSafe("agv/r1/status", ("Standby (At " + getStationName(currentStationID) + ")").c_str());
      sendMqttSafe("agv/r1/station", getStationName(currentStationID).c_str());
      return;
    }

    uint8_t targetID = 4;
    if (cmd == "GO_BLUE") targetID = 1;        // BLUE_S1 = 1
    else if (cmd == "GO_RED") targetID = 2;    // RED_S2 = 2
    else if (cmd == "GO_GREEN") targetID = 3;  // GREEN_S3 = 3
    else if (cmd == "GO_START") targetID = 4;  // START = 4

    if (targetID != 0) {
      String targetStr = getStationName(targetID);

      // 🚨 ระบบกันชนอัจฉริยะ: เช็กทั้งตำแหน่งปัจจุบันของ r2 และเป้าหมายที่ r2 กำลังจะไป
      bool isR2AtTarget = (friendStation == targetStr);
      bool isR2TargetingIt = (friendTarget == targetStr);

      if ((isR2AtTarget || isR2TargetingIt) && targetStr != "START") {
        Serial.println("❌ ไปไม่ได้! r2 จอดขวางหรือกำลังมุ่งหน้าไปที่ " + targetStr);
        sendMqttSafe("agv/r1/status", "Standby (Blocked)");
      } else {
        targetStationID = targetID;
        isWaitingForCommand = false;
        sendMqttSafe("agv/r1/status", ("Moving to " + targetStr).c_str());
        sendMqttSafe("agv/r1/station", "MOVING");
      }
    }
  });

  // 🌟 ดักฟังตำแหน่งปัจจุบันของ r2
  mqttBroker.subscribe("agv/r2/station", [](const char* topic, const char* payload) {
    friendStation = String(payload);
    Serial.println("[MQTT RECV] r2 station: " + friendStation);
  });

  // 🌟 ดักฟังเป้าหมายที่ r2 กำลังจะไป
  mqttBroker.subscribe("agv/r2/status", [](const char* topic, const char* payload) {
    String statusStr = String(payload);
    if (statusStr.startsWith("Moving to ")) {
      friendTarget = statusStr.substring(10);
      Serial.println("[MQTT RECV] r2 target destination: " + friendTarget);
    } else if (statusStr.startsWith("Standby")) {
      friendTarget = "NONE";
    }
  });

  Wire.begin(SDA_PIN, SCL_PIN);
  if (tcs.begin()) tcs.setInterrupt(false);

  stopMotor();
  xTaskCreatePinnedToCore(robotControlTask, "RobotTask", 10000, NULL, 1, &RobotTask, 0);
  xTaskCreatePinnedToCore(colorSensorTask, "ColorTask", 10000, NULL, 1, &ColorTask, 1);
}

void sendMqttSafe(const char* topic, const char* payload) {
  MqttMsg msg;
  strlcpy(msg.topic, topic, sizeof(msg.topic));
  strlcpy(msg.payload, payload, sizeof(msg.payload));
  xQueueSend(mqttQueue, &msg, 0);
}

void loop() {
  MqttMsg msg;
  while (xQueueReceive(mqttQueue, &msg, 0) == pdTRUE) {
    mqttBroker.publish(msg.topic, msg.payload);
  }
  mqttBroker.loop();
  delay(1);
}

void robotControlTask(void* pvParameters) {
  static unsigned long lastIRDebug = 0;
  static unsigned long lastStateDebug = 0;
  static unsigned long lastAppUpdate = 0;

  for (;;) {
    // if (millis() - lastIRDebug > 200) {
    //   int valLeft = digitalRead(sensorLeft);
    //   int valRight = digitalRead(sensorRight);
    //   Serial.println("[IR DEBUG] L:" + String(valLeft) + " | R:" + String(valRight));
    //   lastIRDebug = millis();
    // }

    if (millis() - lastStateDebug > 1000) {
      Serial.println("[SYS DEBUG] Curr:" + getStationName(currentStationID) + " | Target:" + getStationName(targetStationID) + " | r2_at:" + friendStation + " | r2_target:" + friendTarget);
      lastStateDebug = millis();
    }

    if (millis() - lastAppUpdate > 2000) {
      if (isWaitingForCommand) {
        sendMqttSafe("agv/r1/status", ("Standby (At " + getStationName(currentStationID) + ")").c_str());
        sendMqttSafe("agv/r1/station", getStationName(currentStationID).c_str());
      }
      lastAppUpdate = millis();
    }

    if (!isWaitingForCommand) {
      if (lineTracking()) {
        if (!isWaitingForCommand) handleIntersection();
      }
    } else {
      stopMotor();
    }
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
}

void colorSensorTask(void* pvParameters) {
  static unsigned long lastColorDebug = 0;

  for (;;) {
    uint16_t r = 0, g = 0, b = 0, c = 0;
    tcs.getRawData(&r, &g, &b, &c);
    if (r == 0 && g == 0 && b == 0) {
      Wire.begin(SDA_PIN, SCL_PIN);
      tcs.begin();
    }

    uint8_t tempColorID = 0;
    String detectedColor = "START_OR_PATH";

    if (r > 90 && g > 140 && g < 240 && b > 150) {
      detectedColor = "START_OR_PATH";
      tempColorID = 0;
    } else if (r > g && r > b && r > 60) {
      detectedColor = "RED_S2";
      tempColorID = 2;  // RED_S2 = 2
    } else if (r > 80 && r < 165 && g > 160 && g < 360 && b > 90 && b < 230) {
      detectedColor = "GREEN_S3";
      tempColorID = 3;  // GREEN_S3 = 3
    } else if (r > 30 && r < 90 && g > 90 && g < 200 && b > 140 && b < 300) {
      detectedColor = "BLUE_S1";
      tempColorID = 1;  // BLUE_S1 = 1
    } else {
      detectedColor = "START_OR_PATH";
      tempColorID = 0;
    }

    sharedColorID = tempColorID;

    if (millis() - lastColorDebug > 500) {
      Serial.println("[COLOR RAW] R:" + String(r) + " G:" + String(g) + " B:" + String(b) + " => " + detectedColor);
      lastColorDebug = millis();
    }
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}

void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void stopMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
  isStopped = true;
}

bool checkArrivalByColor() {
  uint8_t tID = targetStationID;
  if (!isWaitingForCommand && tID != 0 && tID != 4 && sharedColorID == tID) {
    stopMotor();
    currentStationID = tID;
    String targetStr = getStationName(tID);
    sendMqttSafe("agv/r1/status", ("Standby (At " + targetStr + ")").c_str());
    sendMqttSafe("agv/r1/station", targetStr.c_str());
    isWaitingForCommand = true;
    targetStationID = 0;
    isStopped = true;
    return true;
  }
  return false;
}

bool lineTracking() {
  if (checkArrivalByColor()) return true;
  int valLeft = digitalRead(sensorLeft);
  int valRight = digitalRead(sensorRight);

  if (valLeft == 1 && valRight == 1) {
    stopMotor();
    delay(400);
    return true;
  }
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(kickDuration_ms);
    isStopped = false;
  }

  if (valLeft == 0 && valRight == 0) {
    analogWrite(ENA, motorSpeed);
    analogWrite(ENB, motorSpeed);
    moveForward();
  } else if (valLeft == 0 && valRight == 1) {
    analogWrite(ENA, 55);
    analogWrite(ENB, 80);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  } else if (valLeft == 1 && valRight == 0) {
    analogWrite(ENA, 80);
    analogWrite(ENB, 55);
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
  }
  return false;
}

void arrivedAtStart() {
  if (isWaitingForCommand) return;
  stopMotor();
  currentStationID = 4;  // START = 4
  sendMqttSafe("agv/r1/status", "Standby (At START)");
  sendMqttSafe("agv/r1/station", "START");
  isWaitingForCommand = true;
  targetStationID = 0;
  isStopped = true;
}

void runRoute(const char* route) {
  Serial.println("[ROUTING] Route: " + String(route));
  for (int i = 0; route[i] != '\0'; i++) {
    if (isWaitingForCommand) return;
    if (route[i] == 'S') skipIntersection();
    else if (route[i] == 'R') turnRight();
    else if (route[i] == 'L') turnLeft();
  }
}

void runDetourRoute(const char* route) {
  Serial.println("[DETOUR ROUTING] Executing Detour Bypass: " + String(route));
  for (int i = 0; route[i] != '\0'; i++) {
    if (isWaitingForCommand) return;
    if (route[i] == 'S') skipIntersection();
    else if (route[i] == 'R') turnRight();
    else if (route[i] == 'L') turnLeft();
  }
}

void handleIntersection() {
  if (isWaitingForCommand) return;

  uint8_t tID = targetStationID;
  uint8_t cID = currentStationID;

  if (sharedColorID != 0 && sharedColorID == tID) {
    stopMotor();
    currentStationID = tID;
    String targetStr = getStationName(tID);
    sendMqttSafe("agv/r1/status", ("Standby (At " + targetStr + ")").c_str());
    sendMqttSafe("agv/r1/station", targetStr.c_str());
    isWaitingForCommand = true;
    targetStationID = 0;
    isStopped = true;
    return;
  }

  // 🌟 ประกาศตัวแปรเช็กสถานะการบล็อกของ r2 ให้ครบถ้วน
  bool isR2BlockingBlue = (friendStation == "BLUE_S1" || friendTarget == "BLUE_S1");
  bool isR2BlockingRed = (friendStation == "Red_S2" || friendTarget == "RED_S2");
  bool isR2BlockingGreen = (friendStation == "GREEN_S3" || friendTarget == "GREEN_S3");
  bool isR2BlockingStart = (friendStation == "START" || friendTarget == "START");

  if (cID == 4) {                       // START (4)
    if (tID == 1) runRoute("SSR");      // BLUE_S1 (1)
    else if (tID == 2) runRoute("SR");  // RED_S2 (2)
    else if (tID == 3) {
      if (isR2BlockingRed) {
        Serial.println("🔄 r1 อยู่start แต่ r2 ขวางสีแดง -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("SSRSRSSR");
      } else {
        runRoute("SRSRSR");  // GREEN_S3 (3)
      }                      // GREEN_S3 (3)
    }
  } else if (cID == 1) {  // BLUE_S1 (1)
    if (tID == 2) {       // ไป RED_S2 (2)
      if (isR2BlockingGreen) {
        Serial.println("🔄 r1 อยู่สีน้ำเงิน แต่ r2 ขวางสีเขียว -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSSRSRSSR");
      } else {
        runRoute("RSSRSRSR");
      }
    } else if (tID == 3) {
      runRoute("RSSR");     // ไป GREEN_S3 (3)
    } else if (tID == 4) {  // ไป START (4)
      if (isR2BlockingStart) {
        Serial.println("🔄 r1 อยู่สีน้ำเงิน แต่ r2 ขวางจุดเริ่มต้น -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSRSLSR");
        arrivedAtStart();
      } else {
        runRoute("RSSSRSR");
        arrivedAtStart();
      }
    }
  } else if (cID == 2) {  // RED_S2 (2)
    if (tID == 1) {       // ไป BLUE_S1 (1)
      if (isR2BlockingGreen) {
        Serial.println("🔄 r1 อยู่สีแดง แต่ r2 ขวางสีเขียว -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSSRSRSSSR");
      } else {
        runRoute("RSRSRSSR");
      }
    } else if (tID == 3) {
      runRoute("RSR");      // ไป GREEN_S3 (3)
    } else if (tID == 4) {  // ไป START (4)
      if (isR2BlockingStart) {
        Serial.println("🔄 r1 อยู่สีแดง แต่ r2 ขวางจุดเริ่มต้น -> เปิดใช้ฟังก์ชันเบี่ยงเส้นทาง!");
        runDetourRoute("RSRSLSR");
        arrivedAtStart();
      } else {
        runRoute("RSSRSR");
        arrivedAtStart();
      }
    }
  } else if (cID == 3) {                 // GREEN_S3 (3)
    if (tID == 1) runRoute("RSSR");      // ไป BLUE_S1 (1)
    else if (tID == 2) runRoute("RSR");  // ไป RED_S2 (2)
    else if (tID == 4) {
      runRoute("LSR");
      arrivedAtStart();
    }  // ไป START (4)
  }
}

void turnLeft() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Turn Left");
  stopMotor();
  delay(250);
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(250);
    isStopped = false;
  }
  if (isWaitingForCommand) return;
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  int blackCount = 0;
  int lastState = digitalRead(sensorLeft);
  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorLeft);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
  if (isWaitingForCommand) return;
  stopMotor();
  isStopped = false;
}

void turnRight() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Turn Right");
  stopMotor();
  delay(250);
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(250);
    isStopped = false;
  }
  if (isWaitingForCommand) return;
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  int blackCount = 0;
  int lastState = digitalRead(sensorRight);
  while (blackCount < 1) {
    if (checkArrivalByColor() || isWaitingForCommand) return;
    int currentState = digitalRead(sensorRight);
    if (lastState == 0 && currentState == 1) blackCount++;
    lastState = currentState;
    vTaskDelay(5 / portTICK_PERIOD_MS);
  }
  if (isWaitingForCommand) return;
  stopMotor();
  isStopped = false;
}

void skipIntersection() {
  if (isWaitingForCommand) return;
  Serial.println("[ACTION] Skip Intersection");
  if (isStopped == true) {
    analogWrite(ENA, kickSpeed);
    analogWrite(ENB, kickSpeed);
    moveForward();
    delay(250);
    isStopped = false;
  }
  while (true) {
    if (isWaitingForCommand) return;
    if (lineTracking()) break;
    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}
