// --- ข้อมูลเครือข่ายวงแลน (r1 เป็นคนปล่อย) ---
const char* ap_ssid = "AGV_NETWORK";
const char* ap_pass = "12345678";

// --- สร้างเซิร์ฟเวอร์ Broker อย่างเดียว ---
PicoMQTT::Server mqttBroker;

// 🌟 โครงสร้างสำหรับ "คิวส่งข้อความข้าม Core" (FreeRTOS Queue)
struct MqttMsg {
  char topic[40];
  char payload[60];
};
QueueHandle_t mqttQueue;

// --- พินมอเตอร์และเซนเซอร์ ---
const int SDA_PIN = 21;
const int SCL_PIN = 22;
const int IN1 = 19;
const int IN2 = 4;
const int ENA = 18;
const int IN3 = 16;
const int IN4 = 17;
const int ENB = 27;
const int sensorLeft = 14;
const int sensorRight = 13;

int motorSpeed = 65;
int turnSpeed = 72;
int kickSpeed = 90;
int kickDuration_ms = 200;
bool isStopped = true;

Adafruit_TCS34725 tcs = Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_50MS, TCS34725_GAIN_4X);

// 🌟 ใช้ระบบ ID ตัวเลข
// 1 = BLUE_S1, 2 = RED_S2, 3 = GREEN_S3, 4 = START
volatile uint8_t currentStationID = 4;  // เริ่มต้นที่ START
volatile uint8_t targetStationID = 0;
volatile uint8_t sharedColorID = 0;
volatile bool isWaitingForCommand = true;

String friendStation = "NONE";
String friendTarget = "NONE";  // 🌟 ตัวแปรใหม่เก็บเป้าหมายที่ r2 กำลังจะไป

TaskHandle_t RobotTask;
TaskHandle_t ColorTask;

// 🌟 ฟังก์ชันแปลรหัส ID เป็นชื่อสถานี
String getStationName(uint8_t id) {
  if (id == 1) return "BLUE_S1";
  if (id == 2) return "RED_S2";
  if (id == 3) return "GREEN_S3";
  if (id == 4) return "START";
  return "NONE";
}

bool checkArrivalByColor();
bool lineTracking();
void handleIntersection();
void skipIntersection();
void turnRight();
void turnLeft();
void moveForward();
void stopMotor();
void arrivedAtStart();
void runRoute(const char* route);
void runDetourRoute(const char* route);
